PORT=8080

# Web service mode
RUN_ONCE=false
ENABLE_INTERNAL_SCHEDULER=true
RUN_ON_STARTUP=true

# Signal cadence
SIGNAL_INTERVAL_MINUTES=10
MARKET_SNAPSHOT_TTL_SECONDS=90
REFRESH_REPLAY_BEFORE_RUN=true
REPLAY_REFRESH_HOURS=12

# Push
PUSH_PROVIDER=auto
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace-me
# NTFY_TOPIC=your-private-topic
# NTFY_SERVER=https://ntfy.sh
PUBLISH_PUSH=true
DEDUPE_PUSH=true
PUSH_DEDUPE_HOURS=6

# Security
RUNNER_TOKEN=replace-with-a-long-random-string

# Optional watchlist override
# WATCHLIST=FET,TON,STG,LINK
